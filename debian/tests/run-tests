#!/bin/sh
set -e

cd "$AUTOPKGTEST_TMP" || exit 1

# Run the project's Go test suites. The project is a monorepo; run the
# root module tests (which cover base_core, base_tunnel, platform packages).
# shellcheck disable=SC2005
if ! command -v go >/dev/null 2>&1; then
    echo "go not found in autopkgtest environment" >&2
    exit 77
fi

go test ./...